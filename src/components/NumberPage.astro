---
import type { NumberResult, Mapping, System } from '../lib/mnemonics';

interface Props {
  number: string;
  data: NumberResult;
}

const { number, data } = Astro.props;

const asInt = /^-?\d+$/.test(number) ? Number(number) : null;
const prevNum = asInt !== null ? Math.max(0, asInt - 1) : null;
const nextNum = asInt !== null ? asInt + 1 : null;
const prevHref = prevNum !== null ? `/n/${prevNum}` : null;
const nextHref = nextNum !== null ? `/n/${nextNum}` : null;

const SYSTEMS: ReadonlyArray<{ key: System; label: string; chipMod: string }> = [
  { key: 'cultural', label: 'Cultural', chipMod: 'chip--cultural' },
  { key: 'major',    label: 'Major',    chipMod: 'chip--major' },
  { key: 'keypad',   label: 'T9 keypad', chipMod: 'chip--keypad' },
  { key: 'leet',     label: 'Leet',     chipMod: 'chip--leet' },
  { key: 'math',     label: 'Math',     chipMod: 'chip--math' },
];

const groupedMappings = SYSTEMS.map((s) => ({
  ...s,
  items: data.mappings.filter((m: Mapping) => m.system === s.key),
})).filter((g) => g.items.length > 0);

const tierLabel: Record<string, string> = {
  curated: 'Curated',
  notable: 'Notable',
  longtail: 'Algorithmic',
};

const tierColor: Record<string, string> = {
  curated: 'var(--accent)',
  notable: 'var(--hot)',
  longtail: 'var(--text-dim)',
};
---

<article>
  <!-- ── Specimen header ─────────────────────────────── -->
  <header class="grid items-end gap-x-8 gap-y-4 md:grid-cols-[auto_1fr]">
    <h1 class="specimen text-[clamp(6rem,28vw,18rem)]">{number}</h1>
    <div class="md:pb-3">
      <p class="kicker" style={`color: ${tierColor[data.tier] ?? 'var(--ink)'}`}>
        Tier · {tierLabel[data.tier] ?? data.tier}
      </p>
      <p class="lede mt-4 text-xl text-[color:var(--text)]">{data.summary}</p>
      {asInt !== null && prevHref && nextHref && (
        <p class="kicker mt-5 text-[color:var(--text-dim)]">
          <span class="slash"></span>
          adjacent &nbsp;
          <a class="mono u text-[color:var(--text)]" href={prevHref}>{prevNum}</a>
          &nbsp;·&nbsp;
          <a class="mono u text-[color:var(--text)]" href={nextHref}>{nextNum}</a>
        </p>
      )}
    </div>
  </header>

  <!-- ── Mappings ────────────────────────────────────── -->
  {groupedMappings.length > 0 ? (
    <section class="mt-14 grid gap-4 md:grid-cols-2">
      {groupedMappings.map((g) => (
        <article class="card">
          <span class={`chip ${g.chipMod}`}>{g.label}</span>
          <ul class="mt-4 space-y-3">
            {g.items.map((m) => (
              <li>
                <p class="mono text-2xl leading-tight">{m.to}</p>
                {m.note && (
                  <p class="mt-1 text-sm italic text-[color:var(--text-dim)]">{m.note}</p>
                )}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </section>
  ) : (
    <section class="card mt-14">
      <span class="chip chip--math">Mappings</span>
      <p class="mt-4 text-[color:var(--text-dim)]">
        Nothing landed for this input. Try a different number or word.
      </p>
    </section>
  )}

  <!-- ── Walk ────────────────────────────────────────── -->
  {prevHref && nextHref && (
    <nav class="mt-16 grid gap-3 md:grid-cols-2">
      <a class="card flex items-baseline justify-between hover:bg-[color:var(--accent-soft)] transition-colors" href={prevHref}>
        <span class="kicker text-[color:var(--text-dim)]">← Previous</span>
        <span class="mono text-2xl">{prevNum}</span>
      </a>
      <a class="card flex items-baseline justify-between hover:bg-[color:var(--accent-soft)] transition-colors" href={nextHref}>
        <span class="mono text-2xl">{nextNum}</span>
        <span class="kicker text-[color:var(--text-dim)]">Next →</span>
      </a>
    </nav>
  )}
</article>
