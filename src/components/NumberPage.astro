---
import type { NumberResult, Mapping, System } from '../lib/mnemonics';

interface Props {
  number: string;
  data: NumberResult;
}

const { number, data } = Astro.props;

const asInt = /^-?\d+$/.test(number) ? Number(number) : null;
const prevNum = asInt !== null ? Math.max(0, asInt - 1) : null;
const nextNum = asInt !== null ? asInt + 1 : null;
const prevHref = prevNum !== null ? `/n/${prevNum}` : null;
const nextHref = nextNum !== null ? `/n/${nextNum}` : null;

const SYSTEMS: ReadonlyArray<{ key: System; label: string; chipMod: string }> = [
  { key: 'cultural', label: 'Cultural', chipMod: 'chip--cultural' },
  { key: 'major',    label: 'Major',    chipMod: '' },
  { key: 'keypad',   label: 'T9 keypad', chipMod: '' },
  { key: 'leet',     label: 'Leet',     chipMod: '' },
  { key: 'math',     label: 'Math',     chipMod: 'chip--math' },
];

const groupedMappings = SYSTEMS.map((s) => ({
  ...s,
  items: data.mappings.filter((m: Mapping) => m.system === s.key),
})).filter((g) => g.items.length > 0);

const tierLabel: Record<string, string> = {
  curated: 'Curated',
  notable: 'Notable',
  longtail: 'Algorithmic',
};
---

<article>
  <div class="flex items-baseline justify-between border-b border-[color:var(--hairline)] pb-2">
    <span class="label">{tierLabel[data.tier] ?? data.tier}</span>
    <span class="label">Numeral · entry</span>
  </div>

  <header class="mt-8 grid items-end gap-6 md:grid-cols-[auto_1fr]">
    <h1 class="specimen text-[clamp(5rem,18vw,11rem)]">{number}</h1>
    <div class="md:pb-2">
      <p class="lede">{data.summary}</p>
      {asInt !== null && prevHref && nextHref && (
        <p class="label mt-4 num">
          <span class="dot">Adjacent</span>
          <a class="mono u" href={prevHref}>{prevNum}</a>
          <span class="mx-2" aria-hidden="true">·</span>
          <a class="mono u" href={nextHref}>{nextNum}</a>
        </p>
      )}
    </div>
  </header>

  {groupedMappings.length > 0 ? (
    <section class="entry mt-12">
      {groupedMappings.map((g) => (
        <Fragment>
          <div class="entry-label">
            <span class={`chip ${g.chipMod}`}>{g.label}</span>
          </div>
          <ul class="entry-value space-y-2">
            {g.items.map((m) => (
              <li class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-4">
                <span class="mono text-lg">{m.to}</span>
                {m.note && (
                  <span class="text-sm italic text-[color:var(--text-dim)]">{m.note}</span>
                )}
              </li>
            ))}
          </ul>
        </Fragment>
      ))}
    </section>
  ) : (
    <section class="entry mt-12">
      <div class="entry-label label">Mappings</div>
      <div class="entry-value text-[color:var(--text-dim)]">
        Nothing landed for this input. Try a different number or word.
      </div>
    </section>
  )}

  {prevHref && nextHref && (
    <nav class="mt-16 flex items-baseline justify-between border-t border-[color:var(--hairline)] pt-4">
      <a class="u flex items-baseline gap-3" href={prevHref}>
        <span class="label">Previous</span>
        <span class="mono">{prevNum}</span>
      </a>
      <a class="u flex items-baseline gap-3" href={nextHref}>
        <span class="mono">{nextNum}</span>
        <span class="label">Next</span>
      </a>
    </nav>
  )}
</article>
