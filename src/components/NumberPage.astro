---
import type { NumberResult, Mapping, System } from '../lib/mnemonics';
import { digitalRoot, archetype } from '../lib/numerology';
import { getCuratedWord } from '../lib/entries';

interface Props {
  number: string;
  data: NumberResult;
  siblings?: string[];
}

const { number, data, siblings = [] } = Astro.props;

// Render the comma-separated Major candidate list as inline links for every
// word that has a curated /w/<word> page. Other words stay as plain text
// until the dictionary-backed /w/ catchall is live.
function majorCandidateNodes(toField: string): Array<{ word: string; href: string | null }> {
  return toField
    .split(',')
    .map((w) => w.trim())
    .filter((w) => w.length > 0)
    .map((word) => {
      const curated = getCuratedWord(word);
      return { word, href: curated ? `/w/${encodeURIComponent(word)}` : null };
    });
}

const asInt = /^-?\d+$/.test(number) ? Number(number) : null;
const prevNum = asInt !== null ? Math.max(0, asInt - 1) : null;
const nextNum = asInt !== null ? asInt + 1 : null;
const prevHref = prevNum !== null ? `/n/${prevNum}` : null;
const nextHref = nextNum !== null ? `/n/${nextNum}` : null;

const root = digitalRoot(number);

const SYSTEMS: ReadonlyArray<{ key: System; label: string; chipMod: string; descr: string }> = [
  { key: 'cultural', label: 'Cultural', chipMod: 'chip--cultural', descr: 'the named echo' },
  { key: 'major',    label: 'Major',    chipMod: 'chip--major',    descr: 'the phonetic cipher' },
  { key: 'keypad',   label: 'T9 Keypad', chipMod: 'chip--keypad',  descr: 'the tactile cipher' },
  { key: 'leet',     label: 'Leet',     chipMod: 'chip--leet',     descr: 'the modern glyph' },
  { key: 'math',     label: 'Math',     chipMod: 'chip--math',     descr: 'the property' },
];

const groupedMappings = SYSTEMS.map((s) => ({
  ...s,
  items: data.mappings.filter((m: Mapping) => m.system === s.key),
})).filter((g) => g.items.length > 0);

const tierLabel: Record<string, string> = {
  curated: 'Curated · Hand-written',
  notable: 'Notable · Auto-flagged',
  longtail: 'Algorithmic · Computed',
};
---

<article>
  <p class="kicker text-center">{tierLabel[data.tier] ?? data.tier}</p>

  <header class="mt-4 text-center">
    <h1 class="specimen text-[clamp(4rem,22vw,18rem)]">{number}</h1>
    <p class="lede mx-auto mt-4 text-center">{data.summary}</p>

    {root && (
      <div class="mx-auto mt-6 inline-block border border-[color:var(--gold-dim)] px-6 py-3">
        <p class="kicker">Numerological root</p>
        <p class="mono mt-2 text-[color:var(--gold-dim)] text-sm">{root.steps.join(' → ')}</p>
        <p class="display mt-2 text-4xl font-black text-[color:var(--amaranth)]">{root.root}</p>
        <p class="italic-serif mt-1 text-[color:var(--ink)] opacity-80">— {archetype(root.root)}</p>
      </div>
    )}

    {asInt !== null && prevHref && nextHref && (
      <p class="kicker mt-6 text-[color:var(--gold-dim)]">
        ← <a class="mono text-[color:var(--gold)]" href={prevHref}>{prevNum}</a>
        <span class="dot"></span>
        <a class="mono text-[color:var(--gold)]" href={nextHref}>{nextNum}</a> →
      </p>
    )}
  </header>

  <div class="divider"><span class="line"></span><span class="glyph">readings</span><span class="line"></span></div>

  {groupedMappings.length > 0 ? (
    <section class="grid gap-4 md:grid-cols-2">
      {groupedMappings.map((g) => (
        <article class="card">
          <div class="flex items-baseline justify-between">
            <span class={`chip ${g.chipMod}`}>{g.label}</span>
            <span class="italic-serif text-sm text-[color:var(--ink)] opacity-70">— {g.descr}</span>
          </div>
          <ul class="mt-4 space-y-3">
            {g.items.map((m) => (
              <li>
                {m.system === 'major' ? (
                  <p class="display text-2xl text-[color:var(--ink)]">
                    {majorCandidateNodes(m.to).map((c, i, arr) => (
                      <>
                        {c.href ? (
                          <a class="text-[color:var(--ink)] hover:text-[color:var(--gold)] underline decoration-[color:var(--gold-dim)] underline-offset-4" href={c.href}>{c.word}</a>
                        ) : (
                          <span>{c.word}</span>
                        )}
                        {i < arr.length - 1 && <span class="text-[color:var(--gold-dim)]">, </span>}
                      </>
                    ))}
                  </p>
                ) : (
                  <p class="display text-2xl text-[color:var(--ink)]">{m.to}</p>
                )}
                {m.note && (
                  <p class="italic-serif mt-1 text-sm text-[color:var(--ink)] opacity-75">{m.note}</p>
                )}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </section>
  ) : (
    <section class="card">
      <span class="chip chip--math">Readings</span>
      <p class="italic-serif mt-4 text-[color:var(--ink)] opacity-80">
        Nothing landed for this input. Try a different number or word.
      </p>
    </section>
  )}

  {siblings.length > 0 && root && (
    <section class="mt-12">
      <div class="divider"><span class="line"></span><span class="glyph">same root · {root.root}</span><span class="line"></span></div>
      <p class="sect-sub text-center">others that reduce to <span class="text-[color:var(--amaranth)]">{root.root}</span>.</p>
      <ul class="mx-auto mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-5" style="max-width: 880px;">
        {siblings.map((s) => (
          <li>
            <a class="plate block text-center" href={`/n/${s}`}>
              <div class="plate-digits text-[clamp(28px,4.5vw,40px)]">{s}</div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {prevHref && nextHref && (
    <nav class="mt-12 grid gap-3 md:grid-cols-2">
      <a class="card flex items-baseline justify-between hover:border-[color:var(--gold)]" href={prevHref}>
        <span class="kicker">← Previous</span>
        <span class="mono text-2xl text-[color:var(--gold)]">{prevNum}</span>
      </a>
      <a class="card flex items-baseline justify-between hover:border-[color:var(--gold)]" href={nextHref}>
        <span class="mono text-2xl text-[color:var(--gold)]">{nextNum}</span>
        <span class="kicker">Next →</span>
      </a>
    </nav>
  )}
</article>
