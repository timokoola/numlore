---
const { pathname } = Astro.url;
const isHome = pathname === '/';
---

<header class="border-b border-[color:var(--gold-dim)]">
  <div class="mx-auto flex max-w-5xl items-baseline justify-between gap-x-6 gap-y-3 px-6 py-4">
    <a href="/" class="flex items-center gap-4" aria-label="Numlore home">
      <svg viewBox="0 0 100 100" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.4" class="text-[color:var(--gold)]" aria-hidden="true">
        <circle cx="50" cy="50" r="14"/>
        <line x1="50" y1="2"  x2="50" y2="22"/>
        <line x1="50" y1="78" x2="50" y2="98"/>
        <line x1="2"  y1="50" x2="22" y2="50"/>
        <line x1="78" y1="50" x2="98" y2="50"/>
        <line x1="16" y1="16" x2="30" y2="30"/>
        <line x1="84" y1="84" x2="70" y2="70"/>
        <line x1="16" y1="84" x2="30" y2="70"/>
        <line x1="84" y1="16" x2="70" y2="30"/>
      </svg>
      <span class="display text-xl font-bold tracking-[.18em] uppercase text-[color:var(--ink)]">
        Numl<span class="text-[color:var(--gold)]">o</span>re
      </span>
    </a>
    <nav class="kicker flex items-center gap-x-6">
      <a href="/systems">Systems</a>
      <a href="/about">About</a>
      <a href="/submit">Submit</a>
    </nav>
  </div>
  {!isHome && (
    <div class="border-t border-[color:var(--gold-dim)] bg-[color:var(--night-soft)]">
      <div class="mx-auto max-w-5xl px-6 py-2">
        <a href="/" class="kicker">← Consult another</a>
      </div>
    </div>
  )}
</header>
