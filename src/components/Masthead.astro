---
const { pathname } = Astro.url;
const isHome = pathname === '/';
---

<header class="border-b border-[color:var(--hairline)]">
  <div class="mx-auto flex max-w-5xl items-baseline justify-between px-6 pb-3 pt-6">
    <a href="/" class="flex items-baseline gap-3 no-underline" aria-label="Numlore home">
      <span class="mono text-[1.05rem] tracking-[0.18em] uppercase">Num·Lore</span>
      <span class="hidden sm:inline label">A dictionary of numbers ⇄ words</span>
    </a>
    <nav class="flex items-baseline gap-5 label">
      <a class="hover:text-[color:var(--text)]" href="/systems">Systems</a>
      <a class="hover:text-[color:var(--text)]" href="/about">About</a>
      <a class="hover:text-[color:var(--text)]" href="/submit">Submit</a>
    </nav>
  </div>
  {!isHome && (
    <div class="mx-auto max-w-5xl px-6 pb-3">
      <a href="/" class="label hover:text-[color:var(--text)]">⤺ Look up another</a>
    </div>
  )}
</header>
