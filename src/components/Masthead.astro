---
const { pathname } = Astro.url;
const isHome = pathname === '/';
---

<header class="border-b-2 border-[color:var(--ink)] bg-[color:var(--paper)]">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-3">
    <a href="/" class="flex items-baseline gap-3 no-underline" aria-label="Numlore home">
      <span class="mono text-xl font-bold tracking-tight">
        NUM<span class="text-[color:var(--hot)]">·</span>LORE
      </span>
      <span class="hidden sm:inline kicker text-[color:var(--text-dim)]">
        Dictionary of numbers ⇄ words
      </span>
    </a>
    <nav class="kicker flex items-center gap-x-5">
      <a class="u" href="/systems">Systems</a>
      <a class="u" href="/about">About</a>
      <a class="u" href="/submit">Submit</a>
    </nav>
  </div>
  {!isHome && (
    <div class="border-t-2 border-[color:var(--ink)] bg-[color:var(--ink)] text-[color:var(--paper)]">
      <div class="mx-auto max-w-6xl px-6 py-2">
        <a href="/" class="kicker">← Look up another</a>
      </div>
    </div>
  )}
</header>
