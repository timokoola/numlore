---
// Single-input search. Anything goes — numeric input routes to /n/, text
// to /w/. Live preview renders inline as you type.
---

<div class="search-block">
  <form id="numlore-search" method="get" action="/" autocomplete="off">
    <label class="sr-only" for="numlore-q">Type a number or a word</label>
    <div class="search-shell">
      <span class="search-glyph mono" aria-hidden="true">→</span>
      <input
        id="numlore-q"
        name="q"
        type="text"
        inputmode="text"
        placeholder="007 · 1337 · money · 90210 · password…"
        class="search-input mono"
        role="combobox"
        aria-autocomplete="list"
        aria-controls="numlore-suggestions"
        aria-expanded="false"
        autofocus
      />
      <button type="submit" class="search-go mono" aria-label="Look up">↵</button>
    </div>
    <p class="mt-3 text-sm text-[color:var(--text-dim)]">
      <span class="mono">type anything</span> — a number (with leading zeros if you want), a word, a partial. We figure it out.
    </p>
  </form>

  <ul
    id="numlore-suggestions"
    role="listbox"
    class="suggestions"
    hidden
  ></ul>
</div>

<script>
  type IndexRow = {
    id: string;
    display: string;
    type: 'number' | 'word' | 'category' | 'system';
    path: string;
    keywords?: string;
  };

  const form = document.getElementById('numlore-search') as HTMLFormElement | null;
  const input = document.getElementById('numlore-q') as HTMLInputElement | null;
  const panel = document.getElementById('numlore-suggestions') as HTMLUListElement | null;

  if (form && input && panel) {
    let fusePromise: Promise<{ search: (q: string) => Array<{ item: IndexRow }> }> | null = null;

    const ensureFuse = () => {
      if (fusePromise) return fusePromise;
      fusePromise = (async () => {
        const [{ default: Fuse }, indexRes] = await Promise.all([
          import('fuse.js'),
          fetch('/search-index.json', { credentials: 'omit' }),
        ]);
        const rows: IndexRow[] = await indexRes.json();
        return new Fuse(rows, {
          includeScore: false,
          threshold: 0.32,
          keys: [
            { name: 'id', weight: 2 },
            { name: 'display', weight: 1.5 },
            { name: 'keywords', weight: 0.5 },
          ],
        });
      })();
      return fusePromise;
    };

    const isNumberLike = (s: string) => /^[0-9]+(?:\.[0-9]+)?$/.test(s);

    const routeFor = (raw: string): string => {
      const v = raw.trim();
      if (!v) return '/';
      if (isNumberLike(v)) return `/n/${encodeURIComponent(v)}`;
      const slug = v.toLowerCase().replace(/[^a-z0-9-]+/g, '-').replace(/^-+|-+$/g, '');
      return `/w/${encodeURIComponent(slug)}`;
    };

    const close = () => {
      panel.hidden = true;
      panel.innerHTML = '';
      input.setAttribute('aria-expanded', 'false');
    };

    const render = (rows: IndexRow[]) => {
      if (rows.length === 0) return close();
      panel.innerHTML = rows
        .map((r) => {
          const display = r.type === 'number' ? `<span class="mono">${r.display}</span>` : r.display;
          const typeClass = `tag tag--${r.type}`;
          return `<li role="option" data-path="${r.path}">` +
            `<a href="${r.path}">` +
              `<span class="suggestion-display">${display}</span>` +
              `<span class="${typeClass}">${r.type}</span>` +
            `</a>` +
          `</li>`;
        })
        .join('');
      panel.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    };

    const runQuery = async () => {
      const q = input.value.trim();
      if (!q) {
        close();
        return;
      }
      const direct: IndexRow = isNumberLike(q)
        ? { id: q, display: q, type: 'number', path: `/n/${encodeURIComponent(q)}` }
        : { id: q, display: q, type: 'word', path: routeFor(q) };
      const fuse = await ensureFuse();
      const fuzzy = fuse.search(q).slice(0, 6).map((h) => h.item);
      const seen = new Set<string>();
      const rows: IndexRow[] = [];
      for (const r of [direct, ...fuzzy]) {
        if (seen.has(r.path)) continue;
        seen.add(r.path);
        rows.push(r);
        if (rows.length >= 7) break;
      }
      render(rows);
    };

    input.addEventListener('focus', () => { void ensureFuse(); });
    input.addEventListener('input', () => { void runQuery(); });
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const v = input.value.trim();
      if (!v) return;
      window.location.assign(routeFor(v));
    });
  }
</script>
