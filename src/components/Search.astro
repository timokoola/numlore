---
---
<div class="relative">
  <form id="numlore-search" method="get" action="/" class="flex gap-2 items-stretch" autocomplete="off">
    <label class="sr-only" for="numlore-q">Enter a number or word</label>
    <input
      id="numlore-q"
      name="q"
      type="text"
      inputmode="text"
      placeholder="Type a number or a word…"
      class="flex-1 rounded-[var(--radius)] border border-[color:var(--border)] bg-transparent px-4 py-3 mono text-lg outline-none focus:border-[color:var(--accent)]"
      role="combobox"
      aria-autocomplete="list"
      aria-controls="numlore-suggestions"
      aria-expanded="false"
    />
    <button
      type="submit"
      class="rounded-[var(--radius)] border border-[color:var(--accent)] bg-[color:var(--accent)] px-4 py-3 text-sm font-medium text-white"
    >
      Look up
    </button>
  </form>
  <ul
    id="numlore-suggestions"
    role="listbox"
    class="absolute left-0 right-0 z-10 mt-1 hidden max-h-72 overflow-auto rounded-[var(--radius)] border border-[color:var(--border)] bg-[color:var(--bg)] shadow-sm"
  ></ul>
</div>

<script>
  type IndexRow = {
    id: string;
    display: string;
    type: 'number' | 'word' | 'category' | 'system';
    path: string;
    keywords?: string;
  };

  const form = document.getElementById('numlore-search') as HTMLFormElement | null;
  const input = document.getElementById('numlore-q') as HTMLInputElement | null;
  const panel = document.getElementById('numlore-suggestions') as HTMLUListElement | null;
  if (!form || !input || !panel) {
    // no-op
  } else {
    let fusePromise: Promise<{ search: (q: string) => Array<{ item: IndexRow }> }> | null = null;

    const ensureFuse = () => {
      if (fusePromise) return fusePromise;
      fusePromise = (async () => {
        const [{ default: Fuse }, indexRes] = await Promise.all([
          import('fuse.js'),
          fetch('/search-index.json', { credentials: 'omit' }),
        ]);
        const rows: IndexRow[] = await indexRes.json();
        return new Fuse(rows, {
          includeScore: false,
          threshold: 0.3,
          keys: [
            { name: 'id', weight: 2 },
            { name: 'display', weight: 1.5 },
            { name: 'keywords', weight: 0.5 },
          ],
        });
      })();
      return fusePromise;
    };

    const isNumberLike = (s: string) => /^[0-9]+(?:\.[0-9]+)?$/.test(s);

    const routeFor = (raw: string): string => {
      const v = raw.trim();
      if (!v) return '/';
      if (isNumberLike(v)) return `/n/${encodeURIComponent(v)}`;
      const slug = v.toLowerCase().replace(/[^a-z0-9-]+/g, '-').replace(/^-+|-+$/g, '');
      return `/w/${encodeURIComponent(slug)}`;
    };

    const close = () => {
      panel.classList.add('hidden');
      panel.innerHTML = '';
      input.setAttribute('aria-expanded', 'false');
    };

    const render = (rows: IndexRow[]) => {
      if (rows.length === 0) return close();
      panel.innerHTML = rows
        .map(
          (r, i) =>
            `<li role="option" data-path="${r.path}" data-i="${i}" class="cursor-pointer px-4 py-2 hover:bg-[color:var(--border)]/30">` +
              `<span class="${r.type === 'number' ? 'mono' : ''} text-[color:var(--text)]">${r.display}</span>` +
              `<span class="ml-2 text-xs uppercase tracking-wide text-[color:var(--text-dim)]">${r.type}</span>` +
            `</li>`,
        )
        .join('');
      panel.classList.remove('hidden');
      input.setAttribute('aria-expanded', 'true');
    };

    const runQuery = async () => {
      const q = input.value.trim();
      if (q.length < 1) return close();
      const fuse = await ensureFuse();
      const hits = fuse.search(q).slice(0, 8).map((h) => h.item);
      render(hits);
    };

    input.addEventListener('focus', () => { void ensureFuse(); });
    input.addEventListener('input', () => { void runQuery(); });
    input.addEventListener('blur', () => { setTimeout(close, 120); });

    panel.addEventListener('mousedown', (event) => {
      const target = (event.target as HTMLElement)?.closest('li[data-path]');
      if (target instanceof HTMLElement) {
        event.preventDefault();
        const path = target.dataset.path;
        if (path) window.location.assign(path);
      }
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const v = input.value.trim();
      if (!v) return;
      window.location.assign(routeFor(v));
    });
  }
</script>
