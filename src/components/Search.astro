---
// Oracle-styled single-input search. Anything typed is routed —
// numeric to /n/, text to /w/. Inline live preview as the user types.
---

<section class="oracle" aria-label="lookup">
  <p class="oracle-label">Consult the dictionary</p>
  <form id="numlore-search" class="oracle-row" method="get" action="/" autocomplete="off">
    <label for="numlore-q" class="sr-only">Number or word</label>
    <input
      id="numlore-q"
      name="q"
      type="text"
      inputmode="text"
      placeholder="007 · 1337 · money · 90210 · password…"
      role="combobox"
      aria-autocomplete="list"
      aria-controls="numlore-suggestions"
      aria-expanded="false"
      autofocus
    />
    <button type="submit">Reveal ✦</button>
  </form>
  <p class="oracle-hint">
    Type any number or any word. Numlore figures out the rest.
    <span class="small">N → W or W → N — automatic</span>
  </p>
  <ul
    id="numlore-suggestions"
    role="listbox"
    class="suggestions"
    hidden
  ></ul>
</section>

<script>
  type IndexRow = {
    id: string;
    display: string;
    type: 'number' | 'word' | 'category' | 'system';
    path: string;
    keywords?: string;
  };

  const form = document.getElementById('numlore-search') as HTMLFormElement | null;
  const input = document.getElementById('numlore-q') as HTMLInputElement | null;
  const panel = document.getElementById('numlore-suggestions') as HTMLUListElement | null;

  if (form && input && panel) {
    let fusePromise: Promise<{ search: (q: string) => Array<{ item: IndexRow }> }> | null = null;

    const ensureFuse = () => {
      if (fusePromise) return fusePromise;
      fusePromise = (async () => {
        const [{ default: Fuse }, indexRes] = await Promise.all([
          import('fuse.js'),
          fetch('/search-index.json', { credentials: 'omit' }),
        ]);
        const rows: IndexRow[] = await indexRes.json();
        return new Fuse(rows, {
          includeScore: false,
          threshold: 0.32,
          keys: [
            { name: 'id', weight: 2 },
            { name: 'display', weight: 1.5 },
            { name: 'keywords', weight: 0.5 },
          ],
        });
      })();
      return fusePromise;
    };

    const isNumberLike = (s: string) => /^[0-9]+(?:\.[0-9]+)?$/.test(s);

    const routeFor = (raw: string): string => {
      const v = raw.trim();
      if (!v) return '/';
      if (isNumberLike(v)) return `/n/${encodeURIComponent(v)}`;
      const slug = v.toLowerCase().replace(/[^a-z0-9-]+/g, '-').replace(/^-+|-+$/g, '');
      return `/w/${encodeURIComponent(slug)}`;
    };

    const close = () => {
      panel.hidden = true;
      panel.innerHTML = '';
      input.setAttribute('aria-expanded', 'false');
    };

    const render = (rows: IndexRow[]) => {
      if (rows.length === 0) return close();
      panel.innerHTML = rows
        .map((r) => {
          const display = r.type === 'number'
            ? `<span class="display font-bold text-[color:var(--gold)]">${r.display}</span>`
            : `<span class="italic-serif">${r.display}</span>`;
          return `<li role="option">` +
            `<a href="${r.path}">` +
              `<span>${display}</span>` +
              `<span class="stype">${r.type}</span>` +
            `</a>` +
          `</li>`;
        })
        .join('');
      panel.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    };

    const runQuery = async () => {
      const q = input.value.trim();
      if (!q) { close(); return; }
      const direct: IndexRow = isNumberLike(q)
        ? { id: q, display: q, type: 'number', path: `/n/${encodeURIComponent(q)}` }
        : { id: q, display: q, type: 'word', path: routeFor(q) };
      const fuse = await ensureFuse();
      const fuzzy = fuse.search(q).slice(0, 6).map((h) => h.item);
      const seen = new Set<string>();
      const rows: IndexRow[] = [];
      for (const r of [direct, ...fuzzy]) {
        if (seen.has(r.path)) continue;
        seen.add(r.path);
        rows.push(r);
        if (rows.length >= 7) break;
      }
      render(rows);
    };

    input.addEventListener('focus', () => { void ensureFuse(); });
    input.addEventListener('input', () => { void runQuery(); });
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const v = input.value.trim();
      if (!v) return;
      window.location.assign(routeFor(v));
    });
  }
</script>
