---
import '../styles/global.css';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { siteEntities, webPageSchema } from '../lib/schema';

interface Props {
  title: string;
  description?: string;
  robots?: string;
  ogImage?: string;
  wide?: boolean;
  /**
   * Page-root JSON-LD schema (WebPage, CollectionPage, or similar). When
   * omitted, BaseLayout emits a default WebPage built from {title,
   * description, pathname}.
   */
  pageSchema?: unknown;
  /**
   * Additional schemas to render alongside the page root — typically a
   * BreadcrumbList, plus DefinedTerm / DefinedTermSet etc. The sitewide
   * WebSite + Organization + dictionary DefinedTermSet are always emitted.
   */
  schemas?: unknown[];
}

const {
  title,
  description = 'A bidirectional number↔word mnemonic dictionary.',
  robots,
  ogImage,
  wide = false,
  pageSchema,
  schemas = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://numlore.com').toString();

const rootPageSchema =
  pageSchema ??
  webPageSchema({
    path: Astro.url.pathname,
    name: title,
    description,
  });

const allSchemas: unknown[] = [...siteEntities(), rootPageSchema, ...schemas];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#FAFAF7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E0E10" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Numlore" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    {allSchemas.map((s) => <JsonLd data={s} />)}
    <script defer data-site-id="8a94eed0-5d97-4b94-b629-1c75ec5e8606" src="https://glyphex.io/tracker.js"></script>
  </head>
  <body>
    <Masthead />
    <main class={`mx-auto ${wide ? 'max-w-5xl' : 'max-w-3xl'} px-6 py-14`}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
