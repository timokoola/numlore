---
import '../styles/global.css';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import JsonLd from '../components/JsonLd.astro';
import { siteEntities, webPageSchema, breadcrumbSchema } from '../lib/schema';

interface BreadcrumbItem {
  name: string;
  path: string;
}

interface Props {
  title: string;
  description?: string;
  robots?: string;
  ogImage?: string;
  /**
   * og:type. Defaults to "website" (right for the home, hubs, and static
   * info pages). Use "article" for content pages — number, word, category,
   * and system slug pages.
   */
  ogType?: string;
  wide?: boolean;
  /**
   * Page-root JSON-LD schema (WebPage, CollectionPage, or similar). When
   * omitted, BaseLayout emits a default WebPage built from {title,
   * description, pathname}.
   */
  pageSchema?: unknown;
  /**
   * Additional schemas to render alongside the page root. The sitewide
   * WebSite + Organization + dictionary DefinedTermSet are always emitted,
   * and a BreadcrumbList is generated automatically from `breadcrumbs`.
   */
  schemas?: unknown[];
  /**
   * Page-hierarchy trail. The first item should be the site root. Rendered
   * both as a visible <nav> at the top of <main> and as BreadcrumbList
   * JSON-LD. Omit on the homepage.
   */
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description = 'A bidirectional number↔word mnemonic dictionary.',
  robots,
  ogImage = '/og/default.png',
  ogType = 'website',
  wide = false,
  pageSchema,
  schemas = [],
  breadcrumbs,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://numlore.com').toString();
const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, Astro.site ?? 'https://numlore.com').toString();

const rootPageSchema =
  pageSchema ??
  webPageSchema({
    path: Astro.url.pathname,
    name: title,
    description,
  });

const breadcrumbExtras = breadcrumbs && breadcrumbs.length > 1 ? [breadcrumbSchema(breadcrumbs)] : [];

const allSchemas: unknown[] = [...siteEntities(), rootPageSchema, ...breadcrumbExtras, ...schemas];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#FAFAF7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E0E10" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Numlore" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    {allSchemas.map((s) => <JsonLd data={s} />)}
    <script defer data-site-id="8a94eed0-5d97-4b94-b629-1c75ec5e8606" src="https://glyphex.io/tracker.js"></script>
  </head>
  <body>
    <Masthead />
    <main class={`mx-auto ${wide ? 'max-w-5xl' : 'max-w-3xl'} px-6 py-14`}>
      {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
      <slot />
    </main>
    <Footer />
  </body>
</html>
