---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NumberPage from '../../components/NumberPage.astro';
import { resolveNumber } from '../../lib/mnemonics';
import { definedTermSchema, breadcrumbSchema } from '../../lib/schema';

// SSR longtail fallback. Reached only for /n/<number> paths not in the
// prebuilt set (curated + 0–9999 + notable 5–6 digit). One-year edge cache.
// The sibling src/pages/n/[number].astro wins on specificity for any path
// that was prebuilt; this catchall handles the rest.
export const prerender = false;

const rest = Astro.params.rest ?? '';

// Reject multi-segment paths; /n/ is one-deep.
if (rest.includes('/')) {
  return new Response('Not found', { status: 404 });
}

const number = decodeURIComponent(rest);
const data = await resolveNumber(number);

const robots = data.tier === 'longtail' ? 'noindex,follow' : undefined;

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=31536000, immutable',
);

const schemas = [
  definedTermSchema({
    path: `/n/${number}`,
    name: number,
    description: data.summary,
    termCode: number,
  }),
  breadcrumbSchema([
    { name: 'Numlore', path: '/' },
    { name: number, path: `/n/${number}` },
  ]),
];
---

<BaseLayout
  title={`${number} — Numlore`}
  description={data.summary}
  robots={robots}
  schemas={schemas}
>
  <NumberPage number={number} data={data} />
</BaseLayout>
