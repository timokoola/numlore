---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NumberPage from '../../components/NumberPage.astro';
import { resolveNumber } from '../../lib/mnemonics';
import { definedTermSchema } from '../../lib/schema';
import { numberPageMeta } from '../../lib/page-meta';

// SSR longtail fallback. Reached only for /n/<number> paths not in the
// prebuilt set (curated + 0–9999 + notable 5–6 digit). One-year edge cache.
// The sibling src/pages/n/[number].astro wins on specificity for any path
// that was prebuilt; this catchall handles the rest.
export const prerender = false;

const rest = Astro.params.rest ?? '';

// Reject multi-segment paths; /n/ is one-deep.
if (rest.includes('/')) {
  return new Response('Not found', { status: 404 });
}

const number = decodeURIComponent(rest);

// Only digit-strings and decimals are valid number slugs. Anything else
// (random text, bot probes, malformed URLs) gets a 404 before we burn
// edge CPU on resolveNumber. Length cap keeps absurd inputs out.
if (number.length > 32 || !/^\d+(?:\.\d+)?$/.test(number)) {
  return new Response('Not found', { status: 404 });
}

const data = await resolveNumber(number);

const robots = data.tier === 'longtail' ? 'noindex,follow' : undefined;

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=31536000, immutable',
);

const meta = numberPageMeta(number, data);

const schemas = [
  definedTermSchema({
    path: `/n/${number}`,
    name: number,
    description: meta.description,
    termCode: number,
  }),
];

const breadcrumbs = [
  { name: 'Numlore', path: '/' },
  { name: 'Numbers', path: '/n' },
  { name: number, path: `/n/${number}` },
];
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  robots={robots}
  ogType="article"
  schemas={schemas}
  breadcrumbs={breadcrumbs}
>
  <NumberPage number={number} data={data} />
</BaseLayout>
