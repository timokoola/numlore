---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NumberPage from '../../components/NumberPage.astro';
import { resolveNumber, listPrebuiltNumberIds } from '../../lib/mnemonics';

// Prebuilt tier: curated YAML, every integer 0–9999, and every notable 5–6
// digit number. Longtail 5–6 digit numbers are served by the SSR sibling at
// src/pages/n/[...rest].astro and cached at the edge.
export const prerender = true;

export async function getStaticPaths() {
  return listPrebuiltNumberIds().map((number) => ({ params: { number } }));
}

const { number } = Astro.params;
const data = await resolveNumber(number ?? '');
---

<BaseLayout
  title={`${number} — Numlore`}
  description={data.summary}
>
  <NumberPage number={number ?? ''} data={data} />
</BaseLayout>
