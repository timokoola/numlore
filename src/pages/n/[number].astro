---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NumberPage from '../../components/NumberPage.astro';
import { resolveNumber, listPrebuiltNumberIds } from '../../lib/mnemonics';
import { siblingsByRoot } from '../../lib/related';
import { definedTermSchema } from '../../lib/schema';
import { numberPageMeta } from '../../lib/page-meta';

// Prebuilt tier: curated YAML, every integer 0–9999, and every notable 5–6
// digit number. Longtail 5–6 digit numbers are served by the SSR sibling at
// src/pages/n/[...rest].astro and cached at the edge.
export const prerender = true;

export async function getStaticPaths() {
  return listPrebuiltNumberIds().map((number) => ({ params: { number } }));
}

const { number } = Astro.params;
const id = number ?? '';
const data = await resolveNumber(id);
const siblings = siblingsByRoot(id, 5);
const meta = numberPageMeta(id, data);

const schemas = [
  definedTermSchema({
    path: `/n/${id}`,
    name: id,
    description: meta.description,
    termCode: id,
  }),
];

const breadcrumbs = [
  { name: 'Numlore', path: '/' },
  { name: 'Numbers', path: '/n' },
  { name: id, path: `/n/${id}` },
];

// Per-page social cards only exist for curated entries — see scripts/og-cards/build.ts.
const ogImage = data.tier === 'curated' ? `/og/n/${id}.png` : '/og/default.png';
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  ogType="article"
  ogImage={ogImage}
  schemas={schemas}
  breadcrumbs={breadcrumbs}
>
  <NumberPage number={id} data={data} siblings={siblings} />
</BaseLayout>
