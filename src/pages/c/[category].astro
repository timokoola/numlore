---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadCategory, listCategorySlugs } from '../../lib/mnemonics';

export const prerender = true;

export async function getStaticPaths() {
  const slugs = await listCategorySlugs();
  return slugs.map((slug) => ({ params: { category: slug } }));
}

const { category } = Astro.params;
const data = await loadCategory(category ?? '');
---

<BaseLayout title={`${data.title} — Numlore`} description={data.description} wide={true}>
  <article>
    <div class="flex items-baseline justify-between border-b border-[color:var(--hairline)] pb-2">
      <span class="label">Collection</span>
      <span class="label num">{data.includes.length} entries</span>
    </div>

    <header class="mt-10 grid items-end gap-6 md:grid-cols-[1fr_auto]">
      <div>
        <p class="label">{data.slug}</p>
        <h1 class="mt-2 text-5xl font-medium leading-[1.05] tracking-tight md:text-6xl">{data.title}</h1>
      </div>
      <p class="lede md:max-w-sm md:text-right">{data.description}</p>
    </header>

    <section class="mt-14 entry">
      <div class="entry-label label">Includes</div>
      <div class="entry-value">
        <ul class="grid grid-cols-2 gap-x-6 gap-y-3 sm:grid-cols-3 md:grid-cols-4">
          {data.includes.map((id) => (
            <li class="flex items-baseline gap-3 border-t border-[color:var(--hairline)] pt-2">
              <span class="label num shrink-0">№</span>
              <a class="mono u text-2xl" href={`/n/${id}`}>{id}</a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </article>
</BaseLayout>
