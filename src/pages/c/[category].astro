---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadCategory, listCategorySlugs } from '../../lib/mnemonics';
import { digitalRoot, archetype } from '../../lib/numerology';
import { collectionPageSchema } from '../../lib/schema';
import { categoryPageMeta } from '../../lib/page-meta';

export const prerender = true;

export async function getStaticPaths() {
  const slugs = await listCategorySlugs();
  return slugs.map((slug) => ({ params: { category: slug } }));
}

const { category } = Astro.params;
const data = await loadCategory(category ?? '');

const rows = data.includes.map((id) => {
  const r = digitalRoot(id);
  return { id, root: r?.root ?? 0, label: r ? archetype(r.root) : '' };
});

const meta = categoryPageMeta({
  title: data.title,
  description: data.description,
  count: data.includes.length,
});

const pageSchema = collectionPageSchema({
  path: `/c/${category}`,
  name: data.title,
  description: meta.description,
  items: data.includes.map((id) => ({ name: id, path: `/n/${id}` })),
});

const breadcrumbs = [
  { name: 'Numlore', path: '/' },
  { name: 'Collections', path: '/c' },
  { name: data.title, path: `/c/${category}` },
];
---

<BaseLayout title={meta.title} description={meta.description} ogType="article" ogImage={`/og/c/${category}.png`} wide={true} pageSchema={pageSchema} breadcrumbs={breadcrumbs}>
  <article>
    <p class="kicker text-center">Collection <span class="dot"></span> {data.slug}</p>

    <header class="mt-4 text-center">
      <h1 class="display text-[clamp(3rem,9vw,6rem)] font-bold leading-tight text-[color:var(--ink)]">{data.title}</h1>
      <p class="lede mx-auto mt-3">{data.description}</p>
    </header>

    <div class="divider"><span class="line"></span><span class="glyph">{data.includes.length} entries</span><span class="line"></span></div>

    <section class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4">
      {rows.map((row) => (
        <a class="plate" href={`/n/${row.id}`}>
          <div class="plate-digits">{row.id}</div>
          <p class="plate-reduce">root <span class="arrow">→</span> <span class="root">{row.root}</span></p>
          <p class="plate-meta">{row.label}</p>
        </a>
      ))}
    </section>
  </article>
</BaseLayout>
