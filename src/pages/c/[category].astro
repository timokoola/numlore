---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadCategory, listCategorySlugs } from '../../lib/mnemonics';

export const prerender = true;

export async function getStaticPaths() {
  const slugs = await listCategorySlugs();
  return slugs.map((slug) => ({ params: { category: slug } }));
}

const { category } = Astro.params;
const data = await loadCategory(category ?? '');
---

<BaseLayout title={`${data.title} — Numlore`} description={data.description} wide={true}>
  <article>
    <header class="grid items-end gap-x-8 gap-y-4 md:grid-cols-[1fr_auto] md:items-baseline">
      <div>
        <p class="kicker text-[color:var(--neon)]" style="color: var(--accent)">Collection · {data.slug}</p>
        <h1 class="headline mt-3 text-[clamp(3rem,9vw,6.5rem)]">{data.title}</h1>
        <p class="lede mt-5 text-[color:var(--text)]">{data.description}</p>
      </div>
      <span class="tag tag--category text-base">{data.includes.length} entries</span>
    </header>

    <section class="mt-14 grid gap-3 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
      {data.includes.map((id) => (
        <a class="card flex items-baseline justify-between gap-2 hover:bg-[color:var(--accent-soft)] transition-colors" href={`/n/${id}`}>
          <span class="kicker text-[color:var(--text-dim)]">№</span>
          <span class="mono text-3xl">{id}</span>
        </a>
      ))}
    </section>
  </article>
</BaseLayout>
