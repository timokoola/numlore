---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { definedTermSetSchema, breadcrumbSchema } from '../../lib/schema';

export const prerender = true;

export async function getStaticPaths() {
  return [
    { params: { slug: 'major' } },
    { params: { slug: 'keypad' } },
    { params: { slug: 'leet' } },
    { params: { slug: 'cultural' } },
  ];
}

const { slug } = Astro.params;

interface SystemCopy {
  roman: string;
  title: string;
  subtitle: string;
  body: string;
  table?: Array<{ key: string; value: string }>;
  example?: string;
  chipMod: string;
}

const copy: Record<string, SystemCopy> = {
  major: {
    roman: 'I',
    title: 'The Major System',
    subtitle: 'the phonetic cipher',
    chipMod: 'chip--major',
    body: 'A phonetic mnemonic technique that maps each digit 0–9 to a set of consonant sounds. Vowels, w, y, and h are free to insert, so any number can be rewritten as a pronounceable word.',
    table: [
      { key: '0', value: 's, z' },
      { key: '1', value: 't, d, th' },
      { key: '2', value: 'n, ng' },
      { key: '3', value: 'm' },
      { key: '4', value: 'r' },
      { key: '5', value: 'l' },
      { key: '6', value: 'sh, ch, j' },
      { key: '7', value: 'k, g' },
      { key: '8', value: 'f, v' },
      { key: '9', value: 'p, b' },
    ],
    example: '32 → m·n → "moon"',
  },
  keypad: {
    roman: 'II',
    title: 'T9 phone keypad',
    subtitle: 'the tactile cipher',
    chipMod: 'chip--keypad',
    body: 'Legacy mobile phones mapped letters to digits 2–9. The system survives in vanity numbers and in mnemonic word ↔ number conversion.',
    table: [
      { key: '2', value: 'A B C' },
      { key: '3', value: 'D E F' },
      { key: '4', value: 'G H I' },
      { key: '5', value: 'J K L' },
      { key: '6', value: 'M N O' },
      { key: '7', value: 'P Q R S' },
      { key: '8', value: 'T U V' },
      { key: '9', value: 'W X Y Z' },
    ],
    example: 'M·O·N·E·Y → 66639',
  },
  leet: {
    roman: 'III',
    title: 'Leet (1337-speak)',
    subtitle: 'the modern glyph',
    chipMod: 'chip--leet',
    body: 'Numbers and symbols substituted for similar-looking letters: 0=O, 1=I, 3=E, 4=A, 5=S, 7=T. Common since the early 1980s BBS scene.',
    table: [
      { key: '0', value: 'O' },
      { key: '1', value: 'I, L' },
      { key: '3', value: 'E' },
      { key: '4', value: 'A' },
      { key: '5', value: 'S' },
      { key: '7', value: 'T' },
      { key: '8', value: 'B' },
    ],
    example: '1337 → LEET',
  },
  cultural: {
    roman: 'IV',
    title: 'Cultural references',
    subtitle: 'the named echoes',
    chipMod: 'chip--cultural',
    body: 'Numbers that mean something specific in a cultural or fictional context: 007 (James Bond), 451 (Fahrenheit 451), 90210 (Beverly Hills), 31337 (elite). Curated by hand.',
    example: '90210 → Beverly Hills',
  },
};

const entry = copy[slug ?? ''] ?? { roman: '·', title: 'Unknown system', subtitle: '', body: '', chipMod: '' };

const schemas = [
  definedTermSetSchema({
    path: `/systems/${slug}`,
    setIdFragment: 'set',
    name: entry.title,
    description: entry.body,
    terms: entry.table?.map((row) => ({
      termCode: row.key,
      name: row.value,
      description: `${row.key} ↔ ${row.value}`,
    })),
  }),
  breadcrumbSchema([
    { name: 'Numlore', path: '/' },
    { name: 'Systems', path: '/systems' },
    { name: entry.title, path: `/systems/${slug}` },
  ]),
];
---

<BaseLayout title={`${entry.title} — Numlore`} description={entry.body} wide={true} schemas={schemas}>
  <p class="kicker text-center">Sphere <span class="dot"></span> {entry.roman}</p>
  <h1 class="display mt-3 text-center text-[clamp(3rem,8vw,5.5rem)] font-bold leading-tight text-[color:var(--ink)]">
    {entry.title}
  </h1>
  <p class="lede mx-auto mt-2 text-center italic-serif text-[color:var(--gold-soft)]">— {entry.subtitle}</p>

  <div class="divider"><span class="line"></span><span class="glyph">✦  ☉  ✦</span><span class="line"></span></div>

  <p class="italic-serif mx-auto max-w-prose text-center text-lg">{entry.body}</p>

  {entry.table && (
    <section class="mt-12">
      <p class="kicker text-center">Mapping table</p>
      <dl class="mx-auto mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-5" style="max-width: 880px;">
        {entry.table.map((row) => (
          <div class="card text-center">
            <dt class="display text-3xl font-bold text-[color:var(--amaranth)]">{row.key}</dt>
            <dd class="mono mt-2 text-base text-[color:var(--ink)]">{row.value}</dd>
          </div>
        ))}
      </dl>
    </section>
  )}

  {entry.example && (
    <section class="card mx-auto mt-10 max-w-md text-center">
      <p class="kicker">Example</p>
      <p class="mono mt-3 text-2xl text-[color:var(--gold)]">{entry.example}</p>
    </section>
  )}
</BaseLayout>
