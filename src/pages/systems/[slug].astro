---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = true;

export async function getStaticPaths() {
  return [
    { params: { slug: 'major' } },
    { params: { slug: 'keypad' } },
    { params: { slug: 'leet' } },
    { params: { slug: 'cultural' } },
  ];
}

const { slug } = Astro.params;

interface SystemCopy {
  title: string;
  body: string;
  mod: string;
  table?: Array<{ key: string; value: string }>;
  example?: string;
}

const copy: Record<string, SystemCopy> = {
  major: {
    title: 'The Major System',
    mod: 'major',
    body: 'A phonetic mnemonic technique that maps each digit 0–9 to a set of consonant sounds. Vowels, w, y, and h are free to insert, so any number can be rewritten as a pronounceable word.',
    table: [
      { key: '0', value: 's, z' },
      { key: '1', value: 't, d, th' },
      { key: '2', value: 'n, ng' },
      { key: '3', value: 'm' },
      { key: '4', value: 'r' },
      { key: '5', value: 'l' },
      { key: '6', value: 'sh, ch, j' },
      { key: '7', value: 'k, g' },
      { key: '8', value: 'f, v' },
      { key: '9', value: 'p, b' },
    ],
    example: '32 → m·n → "moon"',
  },
  keypad: {
    title: 'T9 phone keypad',
    mod: 'keypad',
    body: 'Legacy mobile phones mapped letters to digits 2–9. The system survives in vanity numbers and in mnemonic word ↔ number conversion.',
    table: [
      { key: '2', value: 'A B C' },
      { key: '3', value: 'D E F' },
      { key: '4', value: 'G H I' },
      { key: '5', value: 'J K L' },
      { key: '6', value: 'M N O' },
      { key: '7', value: 'P Q R S' },
      { key: '8', value: 'T U V' },
      { key: '9', value: 'W X Y Z' },
    ],
    example: 'M·O·N·E·Y → 66639',
  },
  leet: {
    title: 'Leet (1337-speak)',
    mod: 'leet',
    body: 'Numbers and symbols substituted for similar-looking letters: 0=O, 1=I, 3=E, 4=A, 5=S, 7=T. Common since the early 1980s BBS scene.',
    table: [
      { key: '0', value: 'O' },
      { key: '1', value: 'I, L' },
      { key: '3', value: 'E' },
      { key: '4', value: 'A' },
      { key: '5', value: 'S' },
      { key: '7', value: 'T' },
      { key: '8', value: 'B' },
    ],
    example: '1337 → LEET',
  },
  cultural: {
    title: 'Cultural references',
    mod: 'cultural',
    body: 'Numbers that mean something specific in a cultural or fictional context: 007 (James Bond), 451 (Fahrenheit 451), 90210 (Beverly Hills), 31337 (elite). Curated by hand.',
    example: '90210 → Beverly Hills',
  },
};

const entry = copy[slug ?? ''] ?? { title: 'Unknown system', body: '', mod: '' };
---

<BaseLayout title={`${entry.title} — Numlore`} description={entry.body} wide={true}>
  <header>
    <span class={`chip chip--${entry.mod}`}>System</span>
    <h1 class="headline mt-4 text-[clamp(3rem,8vw,5.5rem)]">{entry.title}</h1>
    <p class="lede mt-5 max-w-prose text-[color:var(--text)]">{entry.body}</p>
  </header>

  {entry.table && (
    <section class="mt-14">
      <p class="kicker text-[color:var(--hot)]">Mapping table</p>
      <dl class="mt-4 grid grid-cols-2 gap-x-6 gap-y-2 sm:grid-cols-4 lg:grid-cols-5">
        {entry.table.map((row) => (
          <div class="card">
            <dt class="mono text-3xl text-[color:var(--hot)]">{row.key}</dt>
            <dd class="mono mt-2 text-base">{row.value}</dd>
          </div>
        ))}
      </dl>
    </section>
  )}

  {entry.example && (
    <section class="card mt-10 max-w-md">
      <p class="kicker text-[color:var(--text-dim)]">Example</p>
      <p class="mono mt-3 text-2xl">{entry.example}</p>
    </section>
  )}
</BaseLayout>
