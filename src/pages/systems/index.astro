---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { collectionPageSchema, breadcrumbSchema } from '../../lib/schema';

export const prerender = true;

const spheres = [
  { slug: 'major',    roman: 'I',   name: 'Major',     descr: 'the phonetic cipher — consonants resolve to digits, vowels are free.', example: '32 ⇄ moon' },
  { slug: 'keypad',   roman: 'II',  name: 'T9 Keypad', descr: 'the tactile cipher — the digits remember the alphabet.',              example: '66639 ⇄ money' },
  { slug: 'leet',     roman: 'III', name: 'Leet',      descr: 'the modern glyph — digits worn as letters, since 1980.',              example: '1337 ⇄ LEET' },
  { slug: 'cultural', roman: 'IV',  name: 'Cultural',  descr: 'the named echoes — codes, addresses, agents, omens.',                 example: '90210 ⇄ Beverly Hills' },
];

const pageSchema = collectionPageSchema({
  path: '/systems',
  name: 'The four spheres',
  description: 'The four mnemonic systems Numlore reads.',
  items: spheres.map((s) => ({ name: s.name, path: `/systems/${s.slug}` })),
});

const schemas = [
  breadcrumbSchema([
    { name: 'Numlore', path: '/' },
    { name: 'Systems', path: '/systems' },
  ]),
];
---

<BaseLayout title="The four spheres — Numlore" description="The four mnemonic systems Numlore reads." wide={true} pageSchema={pageSchema} schemas={schemas}>
  <p class="kicker text-center">Index <span class="dot"></span> the four spheres</p>
  <h1 class="display mt-3 text-center text-[clamp(3rem,9vw,6rem)] font-bold leading-tight text-[color:var(--ink)]">
    Four ways<br/>to read a number.
  </h1>

  <div class="divider"><span class="line"></span><span class="glyph">✦  ☉  ✦</span><span class="line"></span></div>

  <ol class="mx-auto" style="max-width: 760px;">
    {spheres.map((s) => (
      <li>
        <a href={`/systems/${s.slug}`} class="sphere-row block hover:bg-[color:var(--night-soft)] -mx-2 px-2">
          <span class="roman">{s.roman}</span>
          <span>
            <span class="sphere-name block">{s.name}</span>
            <span class="sphere-descr">{s.descr}</span>
            <span class="mono mt-1 block text-xs text-[color:var(--gold-soft)]">{s.example}</span>
          </span>
          <span class="kicker text-[color:var(--gold-dim)]">→</span>
        </a>
      </li>
    ))}
  </ol>
</BaseLayout>
