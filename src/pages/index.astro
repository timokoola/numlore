---
import BaseLayout from '../layouts/BaseLayout.astro';
import Search from '../components/Search.astro';
import { digitalRoot, pythagoreanRoot, archetype } from '../lib/numerology';

export const prerender = true;

const numbers = ['007', '42', '1337', '666', '90210', '31337'];
const words = ['money', 'love', 'password', 'hello'];

const numberRows = numbers.map((id) => {
  const r = digitalRoot(id);
  return { id, root: r?.root ?? 0, steps: r?.steps ?? [], archetype: r ? archetype(r.root) : '' };
});

const wordRows = words.map((w) => {
  const r = pythagoreanRoot(w);
  return { word: w, root: r?.root ?? 0, steps: r?.steps ?? [], archetype: r ? archetype(r.root) : '' };
});

const numberMeta: Record<string, string> = {
  '007': 'Cultural',
  '42':  'Cultural',
  '1337':'Leet',
  '666': 'Cultural',
  '90210':'Cultural',
  '31337':'Leet',
};

const spheres = [
  { roman: 'I',   name: 'Major',     descr: 'the phonetic cipher — consonants resolve to digits, vowels are free.', glyph: '3·2' },
  { roman: 'II',  name: 'T9 Keypad', descr: 'the tactile cipher — the digits remember the alphabet.',              glyph: '6·6·6·3·9' },
  { roman: 'III', name: 'Leet',      descr: 'the modern glyph — digits worn as letters, since 1980.',              glyph: '1·3·3·7' },
  { roman: 'IV',  name: 'Cultural',  descr: 'the named echoes — codes, addresses, agents, omens.',                 glyph: '0·0·7' },
];
---

<BaseLayout
  title="Numlore — a dictionary of numbers and the words they mean"
  description="Type any number or any word — Numlore reveals its cultural references, Major System mnemonics, T9 keypad letters, leet readings, and numerological root."
  wide={true}
>
  <!-- ── Crown / hero ─────────────────────────────────── -->
  <section class="text-center">
    <div class="flex justify-center">
      <svg class="sunburst" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
        <circle cx="50" cy="50" r="14"/>
        <circle cx="50" cy="50" r="20" stroke-dasharray="2 4"/>
        <line x1="50" y1="2"  x2="50" y2="22"/>
        <line x1="50" y1="78" x2="50" y2="98"/>
        <line x1="2"  y1="50" x2="22" y2="50"/>
        <line x1="78" y1="50" x2="98" y2="50"/>
        <line x1="16" y1="16" x2="30" y2="30"/>
        <line x1="84" y1="84" x2="70" y2="70"/>
        <line x1="16" y1="84" x2="30" y2="70"/>
        <line x1="84" y1="16" x2="70" y2="30"/>
        <text x="50" y="55" text-anchor="middle" font-family="Cinzel Variable, Cinzel" font-size="10" fill="currentColor" letter-spacing="0.18em">N·L</text>
      </svg>
    </div>

    <p class="kicker mt-4">Volumen <span class="dot">·</span> i <span class="dot">·</span> the field guide</p>
    <h1 class="display mt-2 text-[clamp(56px,12vw,128px)] font-black tracking-[.04em] leading-[0.95] text-[color:var(--ink)]">
      Numl<span class="text-[color:var(--gold)]">o</span>re
    </h1>
    <p class="lede mx-auto mt-2">
      a dictionary of <em>numbers</em> <span class="text-[color:var(--gold)] not-italic">⇄</span> <em>words</em>,<br/>
      &amp; the meanings they carry.
    </p>
  </section>

  <div class="divider"><span class="line"></span><span class="glyph">✦  ☉  ✦</span><span class="line"></span></div>

  <div class="mx-auto" style="max-width: 720px;">
    <Search />
  </div>

  <!-- ── Six numerals ────────────────────────────────── -->
  <div class="divider"><span class="line"></span><span class="glyph">i · numerals</span><span class="line"></span></div>
  <h2 class="sect-h text-center">Six numerals to begin</h2>
  <p class="sect-sub text-center">each shown with its <em>root</em> — the recursive digital sum.</p>

  <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3">
    {numberRows.map((row) => (
      <a class="plate" href={`/n/${row.id}`}>
        <div class="plate-digits">{row.id}</div>
        <p class="plate-reduce">
          {row.steps.join(' → ')}
          <span class="arrow"> → </span>
          <span class="root">{row.root}</span>
        </p>
        <p class="plate-meta">{numberMeta[row.id] ?? 'Numeral'} · {row.archetype}</p>
      </a>
    ))}
  </div>

  <p class="kicker mt-6 text-center text-[color:var(--gold-dim)]">
    <a href="/n">Browse every curated number →</a>
  </p>

  <!-- ── Four words ──────────────────────────────────── -->
  <div class="divider"><span class="line"></span><span class="glyph">ii · words</span><span class="line"></span></div>
  <h2 class="sect-h text-center">Four words, four roots</h2>
  <p class="sect-sub text-center">reduced via the Pythagorean letter cipher (A=1, B=2, …, I=9, repeating).</p>

  <div class="mx-auto mt-6 grid grid-cols-1 gap-2 sm:grid-cols-2" style="max-width: 720px;">
    {wordRows.map((row) => (
      <a class="slip" href={`/w/${row.word}`}>
        <span class="word">{row.word}</span>
        <span class="calc">{row.steps.join(' → ')} →</span>
        <span class="root">{row.root}</span>
      </a>
    ))}
  </div>

  <p class="kicker mt-6 text-center text-[color:var(--gold-dim)]">
    <a href="/w">Browse every curated word →</a>
  </p>

  <!-- ── Collections ─────────────────────────────────── -->
  <div class="divider"><span class="line"></span><span class="glyph">iii · collections</span><span class="line"></span></div>
  <h2 class="sect-h text-center">Curated sets</h2>
  <p class="sect-sub text-center">hand-grouped by theme.</p>

  <div class="mx-auto mt-6 grid gap-3 sm:grid-cols-3" style="max-width: 880px;">
    <a class="card hover:border-[color:var(--gold)]" href="/c/numerology-roots">
      <p class="kicker">I · Foundation</p>
      <p class="display mt-2 text-2xl font-bold text-[color:var(--ink)]">Numerology roots</p>
      <p class="italic-serif mt-2 text-sm opacity-80">The single digits 1–9 and the three master numbers.</p>
    </a>
    <a class="card hover:border-[color:var(--gold)]" href="/c/angel-numbers">
      <p class="kicker">II · Repeats</p>
      <p class="display mt-2 text-2xl font-bold text-[color:var(--ink)]">Angel numbers</p>
      <p class="italic-serif mt-2 text-sm opacity-80">Repeating sequences from 111 to 999.</p>
    </a>
    <a class="card hover:border-[color:var(--gold)]" href="/c/pop-classics">
      <p class="kicker">III · Echoes</p>
      <p class="display mt-2 text-2xl font-bold text-[color:var(--ink)]">Pop classics</p>
      <p class="italic-serif mt-2 text-sm opacity-80">From THX 1138 to Sheldon's 73.</p>
    </a>
  </div>

  <p class="kicker mt-6 text-center text-[color:var(--gold-dim)]">
    <a href="/c">Browse every collection →</a>
  </p>

  <!-- ── The four spheres ────────────────────────────── -->
  <div class="divider"><span class="line"></span><span class="glyph">iv · vibrations</span><span class="line"></span></div>
  <h2 class="sect-h text-center">The four spheres</h2>
  <p class="sect-sub text-center">how a number speaks.</p>

  <div class="mx-auto mt-4" style="max-width: 720px;">
    {spheres.map((s) => (
      <a href={`/systems/${s.name.toLowerCase().replace(/\s.*$/, '').replace('t9','keypad')}`} class="sphere-row block hover:bg-[color:var(--night-soft)] -mx-2 px-2">
        <span class="roman">{s.roman}</span>
        <span>
          <span class="sphere-name block">{s.name}</span>
          <span class="sphere-descr">{s.descr}</span>
        </span>
        <span class="sphere-glyph">{s.glyph}</span>
      </a>
    ))}
  </div>

  <p class="kicker mt-6 text-center text-[color:var(--gold-dim)]">
    <a href="/systems">Read the four systems →</a>
  </p>

  <!-- ── Tiers ────────────────────────────────────────── -->
  <div class="divider"><span class="line"></span><span class="glyph">iv · tiers</span><span class="line"></span></div>
  <h2 class="sect-h text-center">Three tiers, computed at build</h2>

  <div class="mx-auto mt-6 grid gap-4 md:grid-cols-3" style="max-width: 880px;">
    <article class="card">
      <span class="chip">Curated</span>
      <p class="italic-serif mt-3">Hand-written entries. Indexable. Full design.</p>
    </article>
    <article class="card">
      <span class="chip chip--cultural">Notable</span>
      <p class="italic-serif mt-3">Years, repdigits, palindromes, common PINs, well-known codes. Auto-flagged.</p>
    </article>
    <article class="card">
      <span class="chip chip--math">Algorithmic</span>
      <p class="italic-serif mt-3">5–6 digit longtail. <span class="mono not-italic">noindex,follow</span>. Rendered on demand.</p>
    </article>
  </div>

  <p class="mt-8 text-center kicker text-[color:var(--gold-dim)]">
    <a href="/about">Read the long version →</a>
  </p>
</BaseLayout>
