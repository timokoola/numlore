---
import BaseLayout from '../layouts/BaseLayout.astro';
import Search from '../components/Search.astro';

export const prerender = true;

const tickerNumbers = ['007', '042', '101', '111', '314', '404', '420', '451', '666', '777', '888', '911', '1337', '1984', '2001', '31337', '90210'];
const numberExamples = ['007', '42', '420', '666', '911', '1337', '1984', '2001', '90210', '31337'];
const wordExamples = ['money', 'love', 'password', 'hello'];
const categories = [
  { slug: 'bond-numbers', title: 'Numbers in James Bond', count: 3 },
  { slug: 'angel-numbers', title: 'Angel numbers', count: 9 },
];
const systems = [
  { slug: 'major', title: 'Major System', glyph: '3·2', sub: 'phonetic' },
  { slug: 'keypad', title: 'T9 keypad', glyph: '6·6·6·3·9', sub: 'phone' },
  { slug: 'leet', title: 'Leet', glyph: '1·3·3·7', sub: 'BBS-era' },
  { slug: 'cultural', title: 'Cultural', glyph: '0·0·7', sub: 'references' },
];
---

<BaseLayout
  title="Numlore — a dictionary of numbers and the words they mean"
  description="Type a number to see its cultural references, Major System mnemonics, T9 keypad letters, and leet readings. Type a word to find the numbers it encodes to."
  wide={true}
>
  <!-- ── Hero ──────────────────────────────────────────── -->
  <section class="digit-bg pt-2">
    <p class="kicker text-[color:var(--hot)]">Vol. I · A field guide to the meanings of numbers</p>

    <h1 class="headline mt-3 text-[clamp(3rem,12vw,8rem)]">
      What does
      <span class="mono text-[color:var(--accent)]">42</span>
      <span class="serif-italic text-[color:var(--text-dim)]">mean,</span><br />
      and what number is
      <span class="serif-italic text-[color:var(--hot)]">"money"</span>?
    </h1>

    <p class="lede mt-6 text-[color:var(--text-dim)]">
      Numlore is a bidirectional dictionary. Type a number — get its cultural references, Major System mnemonics, T9 keypad letters, and leet readings. Type a word — get the numbers it encodes to.
    </p>

    <div class="mt-10 max-w-3xl">
      <Search />
    </div>
  </section>

  <!-- ── Number ticker ─────────────────────────────────── -->
  <div class="ticker mt-14">
    <div class="ticker-track">
      {[...tickerNumbers, ...tickerNumbers].map((n) => (
        <span><span class="swatch">▍</span>{n}</span>
      ))}
    </div>
  </div>

  <!-- ── Try / examples ────────────────────────────────── -->
  <section class="mt-14 grid gap-8 md:grid-cols-[1fr_2fr]">
    <div>
      <p class="kicker text-[color:var(--text-dim)]">§01 · Try</p>
      <h2 class="headline mt-2 text-3xl">Curated openers.</h2>
      <p class="mt-3 text-[color:var(--text-dim)]">
        Hand-written entries with cultural references, mnemonics, and context. Tap any to see the page.
      </p>
    </div>
    <div class="card-stack card border-2 border-[color:var(--ink)]">
      <ul class="flex flex-wrap items-baseline gap-x-6 gap-y-3 p-2 text-2xl md:text-3xl">
        {numberExamples.map((n) => (
          <li><a class="mono u" href={`/n/${n}`}>{n}</a></li>
        ))}
      </ul>
      <ul class="flex flex-wrap items-baseline gap-x-6 gap-y-3 p-2 text-2xl md:text-3xl">
        {wordExamples.map((w) => (
          <li><a class="serif-italic u" href={`/w/${w}`}>{w}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── Systems ──────────────────────────────────────── -->
  <section class="mt-16">
    <div class="flex items-baseline justify-between border-b-2 border-[color:var(--ink)] pb-2">
      <p class="kicker">§02 · Four systems Numlore reads</p>
      <a class="kicker u" href="/systems">All systems &rarr;</a>
    </div>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {systems.map((s) => (
        <li>
          <a href={`/systems/${s.slug}`} class="card block hover:bg-[color:var(--accent-soft)] transition-colors">
            <p class="kicker text-[color:var(--text-dim)]">{s.sub}</p>
            <p class="mono mt-3 text-3xl text-[color:var(--hot)]">{s.glyph}</p>
            <p class="mt-3 text-xl font-semibold">{s.title}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ── Collections ──────────────────────────────────── -->
  <section class="mt-16">
    <div class="flex items-baseline justify-between border-b-2 border-[color:var(--ink)] pb-2">
      <p class="kicker">§03 · Collections</p>
      <p class="kicker text-[color:var(--text-dim)]">{categories.length} sets</p>
    </div>
    <ul class="mt-6 grid gap-4 md:grid-cols-2">
      {categories.map((c) => (
        <li>
          <a href={`/c/${c.slug}`} class="card flex items-baseline justify-between gap-3 hover:bg-[color:var(--accent-soft)] transition-colors">
            <span class="text-2xl font-semibold">{c.title}</span>
            <span class="tag tag--category">{c.count}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ── Tiers ────────────────────────────────────────── -->
  <section class="mt-16">
    <p class="kicker">§04 · How pages are tiered</p>
    <h2 class="headline mt-2 text-3xl">Three tiers, computed at build.</h2>
    <div class="mt-6 grid gap-3 md:grid-cols-3">
      <div class="card">
        <span class="chip">Curated</span>
        <p class="mt-3 text-sm">Hand-written YAML. Indexable. In sitemap. Full design.</p>
      </div>
      <div class="card">
        <span class="chip chip--cultural">Notable</span>
        <p class="mt-3 text-sm">Years, palindromes, repdigits, common PINs, well-known codes. Auto-flagged.</p>
      </div>
      <div class="card">
        <span class="chip chip--math">Algorithmic</span>
        <p class="mt-3 text-sm">5–6 digit longtail. <span class="mono">noindex,follow</span>. Rendered on demand.</p>
      </div>
    </div>
    <p class="mt-6 text-sm text-[color:var(--text-dim)]">
      <span class="slash"></span>
      <a class="u" href="/about">Long version on /about</a>.
    </p>
  </section>
</BaseLayout>
