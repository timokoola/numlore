---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;
---

<BaseLayout
  title="Submit an entry — Numlore"
  description="Suggest a number↔word mnemonic for editorial review."
  wide={true}
>
  <header>
    <p class="kicker text-[color:var(--hot)]">Editorial · Submit</p>
    <h1 class="headline mt-3 text-[clamp(3rem,9vw,6rem)]">Suggest an entry.</h1>
    <p class="lede mt-5">Propose a number↔word mnemonic. Accepted entries are published on the site.</p>
  </header>

  <div class="card mt-10 max-w-2xl border-l-[6px] !border-l-[color:var(--hot)]">
    <p class="text-sm">
      <span class="slash"></span>
      Submissions go through editorial review. Accepted entries are published publicly on the site. Don't include personal information.
    </p>
  </div>

  <form method="post" action="/submit" class="mt-10 max-w-2xl space-y-8">
    <div>
      <label for="entry-id" class="kicker block">ID — a number or a single word</label>
      <input
        id="entry-id"
        name="id"
        type="text"
        required
        placeholder="007, money, 1337…"
        class="mt-2 w-full border-2 border-[color:var(--ink)] bg-[color:var(--paper)] px-3 py-3 mono text-2xl focus:outline-none focus:bg-[color:var(--accent-soft)]"
      />
    </div>

    <fieldset>
      <legend class="kicker">Type</legend>
      <div class="mt-2 flex flex-wrap gap-3">
        <label class="card cursor-pointer flex items-center gap-2">
          <input type="radio" name="type" value="number" required class="h-4 w-4 accent-[color:var(--hot)]" />
          <span>Number</span>
        </label>
        <label class="card cursor-pointer flex items-center gap-2">
          <input type="radio" name="type" value="word" class="h-4 w-4 accent-[color:var(--accent)]" />
          <span>Word</span>
        </label>
      </div>
    </fieldset>

    <div>
      <label for="entry-system" class="kicker block">System</label>
      <select id="entry-system" name="system" required
        class="mt-2 w-full border-2 border-[color:var(--ink)] bg-[color:var(--paper)] px-3 py-3 text-lg focus:outline-none focus:bg-[color:var(--accent-soft)]">
        <option value="cultural">cultural</option>
        <option value="major">major</option>
        <option value="keypad">keypad</option>
        <option value="leet">leet</option>
      </select>
    </div>

    <div>
      <label for="entry-to" class="kicker block">Mapping value</label>
      <input
        id="entry-to"
        name="to"
        type="text"
        required
        placeholder="James Bond / sock / 66639"
        class="mt-2 w-full border-2 border-[color:var(--ink)] bg-[color:var(--paper)] px-3 py-3 mono text-xl focus:outline-none focus:bg-[color:var(--accent-soft)]"
      />
    </div>

    <div>
      <label for="entry-note" class="kicker block">Note <span class="text-[color:var(--text-dim)]">— optional context, citation, rationale</span></label>
      <textarea
        id="entry-note"
        name="note"
        rows="4"
        class="mt-2 w-full border-2 border-[color:var(--ink)] bg-[color:var(--paper)] px-3 py-3 text-base focus:outline-none focus:bg-[color:var(--accent-soft)]"
      ></textarea>
    </div>

    <div>
      <p class="kicker">Verify</p>
      <div data-turnstile-placeholder class="mt-2 border-2 border-dashed border-[color:var(--ink)] px-4 py-6 text-sm text-[color:var(--text-dim)]">
        Anti-spam challenge will appear here.
      </div>
    </div>

    <button type="submit" class="btn btn--hot">Submit for review &rarr;</button>
  </form>
</BaseLayout>
