---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;
---

<BaseLayout
  title="Submit an entry — Numlore"
  description="Suggest a number↔word mnemonic for editorial review."
>
  <div class="flex items-baseline justify-between border-b border-[color:var(--hairline)] pb-2">
    <span class="label">Editorial</span>
    <span class="label">Submit</span>
  </div>

  <header class="mt-10">
    <h1 class="text-5xl font-medium tracking-tight md:text-6xl">Submit an entry</h1>
    <p class="lede mt-3">Propose a number↔word mnemonic. Accepted entries are published on the site.</p>
  </header>

  <p class="mt-8 max-w-prose border-l-2 border-[color:var(--secondary)] bg-[color:var(--secondary)]/5 px-4 py-3 text-sm">
    Submissions go through editorial review. Accepted entries are published publicly on the site. Don't include personal information.
  </p>

  <form method="post" action="/submit" class="entry mt-12">
    <div class="entry-label label"><label for="entry-id">ID</label></div>
    <div class="entry-value">
      <input
        id="entry-id"
        name="id"
        type="text"
        required
        placeholder="007, money, …"
        class="field"
      />
      <p class="label mt-1">A number (with leading zeros if you like) or a single word.</p>
    </div>

    <div class="entry-label label">Type</div>
    <div class="entry-value flex gap-6">
      <label class="inline-flex items-center gap-2">
        <input type="radio" name="type" value="number" required class="h-3 w-3 accent-[color:var(--accent)]" /> <span class="label">Number</span>
      </label>
      <label class="inline-flex items-center gap-2">
        <input type="radio" name="type" value="word" class="h-3 w-3 accent-[color:var(--accent)]" /> <span class="label">Word</span>
      </label>
    </div>

    <div class="entry-label label"><label for="entry-system">System</label></div>
    <div class="entry-value">
      <select id="entry-system" name="system" required
        class="w-full border-b border-[color:var(--text)] bg-transparent py-2 text-lg font-medium focus:border-[color:var(--accent)] focus:outline-none">
        <option value="cultural">cultural</option>
        <option value="major">major</option>
        <option value="keypad">keypad</option>
        <option value="leet">leet</option>
      </select>
    </div>

    <div class="entry-label label"><label for="entry-to">Mapping</label></div>
    <div class="entry-value">
      <input
        id="entry-to"
        name="to"
        type="text"
        required
        placeholder="James Bond / sock / 66639"
        class="field"
      />
    </div>

    <div class="entry-label label"><label for="entry-note">Note</label></div>
    <div class="entry-value">
      <textarea
        id="entry-note"
        name="note"
        rows="3"
        placeholder="Optional context, citation, or rationale."
        class="w-full border border-[color:var(--hairline)] bg-transparent p-3 text-base focus:border-[color:var(--accent)] focus:outline-none"
      ></textarea>
    </div>

    <div class="entry-label label">Verify</div>
    <div class="entry-value">
      <div data-turnstile-placeholder class="border border-dashed border-[color:var(--hairline)] px-3 py-4 text-sm text-[color:var(--text-dim)]">
        Anti-spam challenge will appear here.
      </div>
    </div>

    <div class="entry-label"></div>
    <div class="entry-value">
      <button type="submit" class="btn btn--accent">Submit for review &rarr;</button>
    </div>
  </form>
</BaseLayout>
