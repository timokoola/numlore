---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;
---

<BaseLayout
  title="Submit an entry — Numlore"
  description="Suggest a number↔word mnemonic for editorial review."
  wide={true}
>
  <p class="kicker text-center">Editorial <span class="dot"></span> Submit</p>
  <h1 class="display mt-3 text-center text-[clamp(3rem,9vw,6rem)] font-bold leading-tight text-[color:var(--ink)]">
    Offer an entry.
  </h1>
  <p class="lede mx-auto mt-3 text-center">Propose a number↔word mnemonic. Accepted entries are published on the site.</p>

  <div class="divider"><span class="line"></span><span class="glyph">✦  ☉  ✦</span><span class="line"></span></div>

  <div class="card mx-auto max-w-2xl border-l-4 border-l-[color:var(--amaranth)]">
    <p class="italic-serif">
      Submissions go through editorial review. Accepted entries are published publicly on the site. Don't include personal information.
    </p>
  </div>

  <form method="post" action="/submit" class="mx-auto mt-10 max-w-2xl space-y-8">
    <div>
      <label for="entry-id" class="kicker block">ID — a number or a single word</label>
      <input
        id="entry-id" name="id" type="text" required
        placeholder="007, money, 1337…"
        class="mt-2 w-full border-b border-[color:var(--gold-dim)] bg-transparent px-1 py-3 mono text-2xl text-[color:var(--ink)] focus:outline-none focus:border-[color:var(--gold)]"
      />
    </div>

    <fieldset>
      <legend class="kicker">Type</legend>
      <div class="mt-2 flex flex-wrap gap-4">
        <label class="flex cursor-pointer items-center gap-2">
          <input type="radio" name="type" value="number" required class="h-4 w-4 accent-[color:var(--gold)]" />
          <span class="italic-serif text-lg">Number</span>
        </label>
        <label class="flex cursor-pointer items-center gap-2">
          <input type="radio" name="type" value="word" class="h-4 w-4 accent-[color:var(--gold)]" />
          <span class="italic-serif text-lg">Word</span>
        </label>
      </div>
    </fieldset>

    <div>
      <label for="entry-system" class="kicker block">Sphere</label>
      <select id="entry-system" name="system" required
        class="mt-2 w-full border-b border-[color:var(--gold-dim)] bg-transparent px-1 py-3 italic-serif text-lg text-[color:var(--ink)] focus:outline-none focus:border-[color:var(--gold)]">
        <option value="cultural">cultural — the named echo</option>
        <option value="major">major — the phonetic cipher</option>
        <option value="keypad">keypad — the tactile cipher</option>
        <option value="leet">leet — the modern glyph</option>
      </select>
    </div>

    <div>
      <label for="entry-to" class="kicker block">Mapping value</label>
      <input
        id="entry-to" name="to" type="text" required
        placeholder="James Bond / sock / 66639"
        class="mt-2 w-full border-b border-[color:var(--gold-dim)] bg-transparent px-1 py-3 mono text-xl text-[color:var(--ink)] focus:outline-none focus:border-[color:var(--gold)]"
      />
    </div>

    <div>
      <label for="entry-note" class="kicker block">Note <span class="text-[color:var(--gold-dim)] normal-case">— optional context, citation, rationale</span></label>
      <textarea
        id="entry-note" name="note" rows="4"
        class="mt-2 w-full border border-[color:var(--gold-dim)] bg-transparent px-3 py-3 italic-serif text-base text-[color:var(--ink)] focus:outline-none focus:border-[color:var(--gold)]"
      ></textarea>
    </div>

    <div>
      <p class="kicker">Verify</p>
      <div data-turnstile-placeholder class="mt-2 border border-dashed border-[color:var(--gold-dim)] px-4 py-6 italic-serif text-sm text-[color:var(--gold-dim)]">
        Anti-spam challenge will appear here.
      </div>
    </div>

    <button type="submit" class="btn">Submit for review ✦</button>
  </form>
</BaseLayout>
